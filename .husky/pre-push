#!/usr/bin/env sh

# Prevent a feature branch with a mistaken upstream from updating remote main.
# Ported from the previous local .git/hooks/pre-push (husky now owns hooksPath).
while read local_ref local_oid remote_ref remote_oid
do
    if [ "$remote_ref" = "refs/heads/main" ] && [ "$local_ref" != "refs/heads/main" ]; then
        echo "Blocked: $local_ref cannot be pushed directly to $remote_ref." >&2
        echo "Push the feature branch to a same-named remote branch, or checkout main first." >&2
        exit 1
    fi
done

exit 0
