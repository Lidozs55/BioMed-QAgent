{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://biomedqagent.local/schemas/hub_gene_result.schema.json",
  "title": "HubGeneResult",
  "description": "hub gene 链式分析结果：基于 PPI 网络识别 hub 基因，并反查上游调控因子与下游靶基因。由 scripts/analysis/hub_gene_analyzer.py 生成。",
  "type": "object",
  "required": ["task_id", "analysis_type", "hub_genes", "network_summary", "summary", "created_at"],
  "additionalProperties": false,
  "properties": {
    "task_id": {"type": "string"},
    "analysis_type": {"type": "string", "const": "hub_gene_analysis"},
    "hub_genes": {
      "type": "array",
      "description": "hub 基因列表（degree top 10%），含链式扩展的上游/下游信息",
      "items": {
        "type": "object",
        "required": ["gene", "degree", "betweenness", "is_hub"],
        "additionalProperties": false,
        "properties": {
          "gene": {"type": "string"},
          "degree": {"type": "integer"},
          "betweenness": {"type": "number"},
          "closeness": {"type": "number", "default": 0},
          "is_hub": {"type": "boolean"},
          "upstream_tf": {
            "type": "array",
            "description": "上游调控因子（转录因子），来自 upstream_regulator 分析",
            "items": {"type": "string"}
          },
          "downstream_targets": {
            "type": "array",
            "description": "下游靶基因",
            "items": {"type": "string"}
          },
          "pathways": {
            "type": "array",
            "description": "该 hub 基因参与的通路",
            "items": {"type": "string"}
          },
          "druggability": {
            "type": "string",
            "enum": ["known_target", "potential_target", "undrugggable", "unknown"],
            "description": "成药性评估"
          }
        }
      }
    },
    "network_summary": {
      "type": "object",
      "required": ["total_nodes", "total_edges", "hub_count", "modules"],
      "additionalProperties": false,
      "properties": {
        "total_nodes": {"type": "integer"},
        "total_edges": {"type": "integer"},
        "hub_count": {"type": "integer"},
        "modules": {"type": "integer", "description": "连通分量数"}
      }
    },
    "chart_data": {
      "type": "object",
      "description": "用于可视化 hub 网络的结构化数据",
      "properties": {
        "nodes": {"type": "array"},
        "edges": {"type": "array"}
      }
    },
    "summary": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
