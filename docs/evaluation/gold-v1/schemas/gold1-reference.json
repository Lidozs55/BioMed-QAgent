{
  "schema_id": "gold1-reference",
  "version": "1",
  "family": "gene_expression",
  "tables": [
    {"table_id":"datasets","role":"primary","granularity":"one row per GEO series/platform","primary_key":["geo_accession","platform_accession"],"columns":["geo_accession","title","organism","disease","tissue","platform_accession","sample_count","data_type","source_url"]},
    {"table_id":"samples","role":"supporting","granularity":"one row per GEO sample","primary_key":["geo_sample_id"],"columns":["geo_sample_id","geo_series_id","sample_title","organism","tissue","disease_state","sample_type","group_assignment","raw_characteristics","source_locator"]},
    {"table_id":"expression_long","role":"primary","granularity":"one expression measurement per dataset/sample/feature","primary_key":["dataset_id","sample_id","probe_id","gene_id"],"columns":["dataset_id","sample_id","gene_id","gene_symbol","probe_id","expression_value","unit","scale","platform_id","mapping_status","source_file","source_row","source_column"]},
    {"table_id":"probe_gene_mapping","role":"supporting","granularity":"one probe-to-gene mapping assertion","primary_key":["platform_id","probe_id","gene_id"],"columns":["platform_id","probe_id","gene_id","gene_symbol","mapping_type","mapping_status","ambiguous_flag","source_annotation_file"]}
  ],
  "relations":[{"from":"samples.geo_series_id","to":"datasets.geo_accession","cardinality":"many_to_one","missing":"reject"},{"from":"expression_long.sample_id","to":"samples.geo_sample_id","cardinality":"many_to_one","missing":"reject"},{"from":"expression_long.probe_id+platform_id","to":"probe_gene_mapping.probe_id+platform_id","cardinality":"many_to_many","missing":"profile_defined"}],
  "required_provenance":["source_asset_id","source_locator","parser_version","mapping_version"],
  "confidence_policy":"sample group and probe mapping uncertainty remain explicit; unresolved required values block publication"
}
