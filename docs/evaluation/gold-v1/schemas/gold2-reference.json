{
  "schema_id": "gold2-reference",
  "version": "1",
  "family": "gene_expression",
  "tables": [
    {"table_id":"study_records","role":"primary","granularity":"one row per selected GEO study/platform","primary_key":["geo_accession","platform"],"columns":["geo_accession","title","pmid","platform","organism","sample_count","mutation_annotation_available","expression_file","clinical_file"]},
    {"table_id":"sample_annotations","role":"supporting","granularity":"one row per sample clinical/EGFR annotation","primary_key":["sample_id"],"columns":["sample_id","patient_id","histology","tumor_stage","smoking_status","treatment_status","egfr_status","egfr_variant","variant_position","variant_allele","annotation_source","raw_annotation","annotation_confidence"]},
    {"table_id":"egfr_variant_records","role":"supporting","granularity":"one EGFR variant assertion per sample","primary_key":["sample_id","gene_symbol","protein_change","source_locator"],"columns":["sample_id","gene_symbol","variant_text","variant_class","protein_change","exon","mutation_status","source_locator","confidence_level"]},
    {"table_id":"probe_expression","role":"primary","granularity":"one probe measurement per sample","primary_key":["sample_id","probe_id"],"columns":["sample_id","probe_id","raw_value","unit","scale","platform_id","source_file","source_row","source_column"]},
    {"table_id":"gene_expression","role":"derived","granularity":"one mapped gene value per sample/probe record","primary_key":["sample_id","probe_id","gene_id"],"columns":["sample_id","gene_id","gene_symbol","probe_id","mapped_value","mapping_status","mapping_rule","source_probe_record"]}
  ],
  "relations":[{"from":"sample_annotations.sample_id","to":"probe_expression.sample_id","cardinality":"one_to_many","missing":"reject"},{"from":"egfr_variant_records.sample_id","to":"sample_annotations.sample_id","cardinality":"many_to_one","missing":"profile_defined"},{"from":"gene_expression.source_probe_record","to":"probe_expression.sample_id+probe_id","cardinality":"many_to_one","missing":"reject"}],
  "required_provenance":["source_asset_id","source_locator","parser_version","mapping_version","annotation_confidence"],
  "confidence_policy":"historical corrupted prompt is inadmissible; missing EGFR status remains unknown rather than inferred"
}
