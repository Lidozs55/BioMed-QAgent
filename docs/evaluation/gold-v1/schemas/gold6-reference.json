  "relations":[{"from":"experiment_records.paper_id","to":"paper_records.pmid+pmcid+doi","cardinality":"many_to_one","missing":"reject"},{"from":"activity_value_records.experiment_id","to":"experiment_records.experiment_id","cardinality":"many_to_one","missing":"reject"},{"from":"chart_series.paper_id","to":"paper_records.pmid+pmcid+doi","cardinality":"many_to_one","missing":"reject"}],
