{
  "schema_id": "gold6-reference",
  "version": "1",
  "family": "bioactivity_measurement",
  "tables": [
    {"table_id":"paper_records","role":"supporting","granularity":"one paper","primary_key":["pmid","pmcid","doi"],"columns":["pmid","pmcid","doi","title","journal","publication_date","authors","open_access_status","source_url"]},
    {"table_id":"experiment_records","role":"supporting","granularity":"one paper experiment","primary_key":["experiment_id"],"columns":["experiment_id","paper_id","protein","variant","construct","ligand","assay_type","cell_line_or_system","temperature","buffer","incubation_time","source_locator","extraction_method"]},
    {"table_id":"activity_value_records","role":"primary","granularity":"one extracted activity value","primary_key":["experiment_id","compound","protein_variant","activity_type","table_or_figure","row_label","column_label"],"columns":["experiment_id","compound","protein_variant","activity_type","activity_value","activity_unit","relation","replicate_count","error_value","error_type","original_text","table_or_figure","page_number","row_label","column_label","confidence_level"]},
    {"table_id":"chart_series","role":"supporting","granularity":"one chart series","primary_key":["paper_id","figure_id","series_label"],"columns":["paper_id","figure_id","series_label","x_axis_name","x_axis_unit","y_axis_name","y_axis_unit","x_scale","y_scale","legend_text","axis_validation_status","legend_validation_status","human_review_status"]},
    {"table_id":"chart_points","role":"derived","granularity":"one chart point","primary_key":["figure_id","series_label","x_value","y_value"],"allow_empty":"only when chart series explicitly records axis/legend uncertainty or no reliable pixels","columns":["figure_id","series_label","x_value","y_value","point_type","estimated_or_exact","pixel_or_coordinate_locator","extraction_confidence","review_status"]},
    {"table_id":"supplementary_asset_records","role":"supporting","granularity":"one supplementary asset","primary_key":["paper_id","asset_name"],"columns":["paper_id","asset_name","asset_type","download_url","sha256","file_size","parse_status","table_count","source_locator"]}
