+) -> None:
+    """D2: cancelling between validation and publish yields a cancelled
+    outcome and no publication directory."""
+    from app.datasets.runtime import OperationKind
+
+    token = _FlagToken()
+    bindings = [_binding("binding_gdc", "gdc", "gdc.expression.v1")]
+    spec = _spec(bindings)
