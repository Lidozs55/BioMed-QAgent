+      data-slot="latest-run-summary"
+      className="flex flex-col gap-0.5 border-b border-border px-5 pb-2 text-xs text-muted-foreground"
+    >
+      {lines.map((line) => (
+        <p key={line}>{line}</p>
+      ))}
+    </div>
+  );
