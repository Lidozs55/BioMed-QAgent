# ---------------------------------------------------------------------------
# DashScope (Qwen) OpenAI 兼容模式
# ---------------------------------------------------------------------------
DASHSCOPE_API_KEY=your-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus

# ---------------------------------------------------------------------------
# NCBI E-utilities identity (TODO §1.6)
#
# NCBI requires a contact email and tool name for all E-utilities requests.
# Without an API key, NcbiEutilsClient falls back to the 3 req/s public quota;
# with a key, the quota rises to 10 req/s. See app/integrations/ncbi/client.py.
# ---------------------------------------------------------------------------
NCBI_EMAIL=biomed-qagent@example.com
NCBI_TOOL=BioMedQAgent
NCBI_API_KEY=
NCBI_USER_AGENT=BioMed-QAgent/0.1 (biomed-qagent@example.com)

# ---------------------------------------------------------------------------
# Phase 7 TypeScript Application Host（正常开发入口）
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=5173
APP_HOST=ts
AGENT_RUNTIME=pi
DATASET_CORE=ts
PI_EXPERIMENTAL=0

# FastAPI 默认不启动。legacy Agent、Python Core 或 experimental Pi profile 启用时，
# Host 才管理 private loopback 子进程；附加外部诊断后端时在两侧提供同一 secret。
LEGACY_BACKEND_PORT=0
# LEGACY_BACKEND_URL=http://127.0.0.1:8000
# PI_DATASET_BRIDGE_SECRET=replace-with-a-random-local-secret

# Pi 模型配置；PI_* 未设置时回退到上面的 DashScope / MODEL_NAME 配置。
PI_PROVIDER=dashscope
# PI_MODEL=qwen-plus
# PI_API_KEY=your-api-key-here
# PI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Development exec 默认关闭；只在受控的本地迁移验证中显式启用。
WORKSPACE_DEV_EXEC=0
LEGACY_READINESS_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000

# OUTPUT_DIR 覆盖必须使用绝对路径。未设置时 Host（及可选 managed FastAPI）使用
# backend/data/output。离线 fixture 只能通过 experimental 请求的 fixture_profile
# allowlist 显式选择，没有隐式环境开关。

# ---------------------------------------------------------------------------
# 爬虫行为（原 §5.3；请求间隔限速）
# ---------------------------------------------------------------------------
# RATE_LIMIT_SECONDS=2.0

# ---------------------------------------------------------------------------
# Durable task/session pagination (advanced — defaults are usually fine)
# ---------------------------------------------------------------------------
# TASK_PAGE_SIZE=30
# TASK_PAGE_MAX_SIZE=100
# TASK_MESSAGE_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# Runtime concurrency and live-event backpressure (advanced)
# ---------------------------------------------------------------------------
# RUNTIME_MAX_ACTIVE_RUNS=4
# RUNTIME_SYNC_WORKER_THREADS=4
# RUNTIME_RUN_QUEUE_SIZE=100
# RUNTIME_SUBSCRIBER_QUEUE_SIZE=1000

# ---------------------------------------------------------------------------
# 日志
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
