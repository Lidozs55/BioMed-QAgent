# Prevent line-ending conversion for test fixtures (SHA256 integrity)
server/tests/phase5/fixtures/**/* -text
server/tests/fixtures/**/* -text
server/tests/fixtures/b3-memory-disk-parity-v1.json text eol=lf

# Node CLI scripts carry a shebang and are imported by tests; keep them LF
# (CRLF breaks the esbuild transform used by vitest on Windows)
scripts/*.mjs text eol=lf

# Gold evaluation checksums freeze byte-level inputs; keep all non-prompt
# metadata and verifier files LF on every platform. Prompts remain binary under
# the directory-local rule so their original bytes are never normalized.
docs/evaluation/gold-v1/** text eol=lf
docs/evaluation/gold-v1/prompts/*.txt -text

# Shell hooks must remain LF (CRLF breaks sh execution on Windows)
.husky/* -text
